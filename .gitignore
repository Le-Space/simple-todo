node_modules/
build/
.svelte-kit/
test-results/
playwright-report/
apps/*/e2e/relay-info.json
apps/*/e2e/relay.log
apps/*/relay/
.env
.env.*
!.env.example

# Runtime state from a local run — OrbitDB keystores and the E2E relay's data.
# The identities in there are throwaway, but they are keys, and they are not
# repository content.
apps/*/orbitdb/
apps/*/relay/
apps/*/e2e/relay-info.json
apps/*/e2e/relay.log

# A chapter's own workflows do not travel: GitHub reads .github at the root.
apps/*/.github/

# Python-Cache der Werkzeuge
__pycache__/
*.pyc

# Vitest's browser mode drops a PNG here when a test fails, and the packages had
# nothing ignoring it -- which is how screenshots end up committed next to the
# source they were taken from (see apps/qr01/src/lib).
**/__screenshots__/
