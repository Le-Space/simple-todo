{
  "compilerOptions": {
    "checkJs": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["packages/*/src/**/*.js", "packages/*/src/**/*.svelte", "tools/**/*.mjs"]
}
