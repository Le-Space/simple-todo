engine-strict=true
# Not the machine's choice: with `node-linker=hoisted` every dependency lands in
# the workspace root, and each app's own `node_modules/` stays nearly empty.
# vite.config.js reads `node_modules/<dep>/package.json` to stamp the versions
# into the header, so a hoisted install silently reported "null" for OrbitDB,
# Helia and libp2p. CI installs isolated; so does this repo, on every machine.
node-linker=isolated
